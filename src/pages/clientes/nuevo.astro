---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';

const hoy = new Date().toISOString().split('T')[0];
---

<LayoutAdmin title="Nuevo Crédito - Sistema de Préstamos">
  <div class="form-wrapper">
    
    <div class="form-header">
      <a href="/" class="back-link">&larr; Volver</a>
      <h1>Otorgar Nuevo Crédito</h1>
    </div>

    <div id="error-box" class="alert-error" style="display: none;"></div>

    <form id="form-credito" class="card form-container">
      
      <!-- Sección 1: Cliente -->
      <fieldset class="form-section">
        <legend>1. Datos del Cliente</legend>
        
        <div class="form-group">
          <label>Nombre *</label>
          <input type="text" id="nombre" required placeholder="Ej. Carlos" />
        </div>

        <div class="form-group">
          <label>Apellido *</label>
          <input type="text" id="apellido" required placeholder="Ej. Pérez" />
        </div>

        <div class="form-group">
          <label>WhatsApp (con código país) *</label>
          <input type="tel" id="whatsapp" required placeholder="+584121234567" />
        </div>

        <div class="form-group">
          <label>Correo electrónico (opcional)</label>
          <input type="email" id="correo" placeholder="cliente@correo.com" />
        </div>

        <div class="form-group">
          <label>Notas / Garantía</label>
          <textarea id="notas" rows="2" placeholder="Detalles de garantía o referencias..."></textarea>
        </div>
      </fieldset>

      <!-- Sección 2: Préstamo -->
      <fieldset class="form-section">
        <legend>2. Condiciones del Préstamo (7 días)</legend>

        <div class="form-group">
          <label>Monto a prestar (USDT) *</label>
          <input type="number" id="input-monto" step="0.01" min="1" required placeholder="100.00" />
        </div>

        <div class="form-group">
          <label>Interés Semanal (%)</label>
          <input type="number" id="input-tasa" step="0.01" value="20" required />
        </div>

        <div class="form-group">
          <label>Fecha de Entrega</label>
          <input type="date" id="input-fecha" value={hoy} required />
        </div>

        <div class="form-group">
          <label>Método de Desembolso</label>
          <select id="metodo_pago">
            <option value="USDT - Binance Pay">USDT - Binance Pay</option>
            <option value="USDT - Red TRC20 / BEP20">USDT - Red TRC20 / BEP20</option>
            <option value="Efectivo USD">Efectivo USD</option>
            <option value="Zinli / Wally">Zinli / Wally</option>
            <option value="Pago Móvil / Bolívares">Pago Móvil / Bolívares</option>
          </select>
        </div>

        <!-- Resumen en vivo -->
        <div class="calc-preview">
          <div>
            <span class="calc-label">Interés 1ra semana:</span>
            <span id="preview-interes" class="calc-value-yellow">$0.00</span>
          </div>
          <div>
            <span class="calc-label">Total en 7 días:</span>
            <span id="preview-total" class="calc-value-green">$0.00</span>
          </div>
          <div>
            <span class="calc-label">Fecha de corte:</span>
            <span id="preview-fecha" class="calc-value-white">--/--/----</span>
          </div>
        </div>
      </fieldset>

      <div class="form-actions">
        <a href="/" class="btn-secondary" style="text-align: center; text-decoration: none;">Cancelar</a>
        <button type="submit" id="btn-submit" class="btn-primary">Registrar y Desembolsar</button>
      </div>

    </form>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const inputMonto = document.getElementById('input-monto') as HTMLInputElement;
    const inputTasa = document.getElementById('input-tasa') as HTMLInputElement;
    const inputFecha = document.getElementById('input-fecha') as HTMLInputElement;

    const previewInteres = document.getElementById('preview-interes');
    const previewTotal = document.getElementById('preview-total');
    const previewFecha = document.getElementById('preview-fecha');

    function actualizarResumen() {
      const monto = parseFloat(inputMonto.value) || 0;
      const tasa = parseFloat(inputTasa.value) || 0;
      const interes = monto * (tasa / 100);
      const total = monto + interes;

      if (previewInteres) previewInteres.textContent = `$${interes.toFixed(2)}`;
      if (previewTotal) previewTotal.textContent = `$${total.toFixed(2)}`;

      if (inputFecha.value && previewFecha) {
        const fecha = new Date(inputFecha.value + 'T00:00:00');
        fecha.setDate(fecha.getDate() + 7);
        previewFecha.textContent = fecha.toLocaleDateString('es-ES');
      }
    }

    inputMonto?.addEventListener('input', actualizarResumen);
    inputTasa?.addEventListener('input', actualizarResumen);
    inputFecha?.addEventListener('change', actualizarResumen);
    actualizarResumen();

    const form = document.getElementById('form-credito') as HTMLFormElement;
    const errorBox = document.getElementById('error-box');
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.style.display = 'none';
      btnSubmit.textContent = 'Procesando...';
      btnSubmit.setAttribute('disabled', 'true');

      const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
      const apellido = (document.getElementById('apellido') as HTMLInputElement).value;
      const whatsapp = (document.getElementById('whatsapp') as HTMLInputElement).value;
      const correo = (document.getElementById('correo') as HTMLInputElement).value;
      const notas = (document.getElementById('notas') as HTMLTextAreaElement).value;
      const monto = parseFloat(inputMonto.value);
      const tasa = parseFloat(inputTasa.value);
      const fecha_entrega = inputFecha.value;
      const metodo_pago = (document.getElementById('metodo_pago') as HTMLSelectElement).value;

      try {
        // Llamada directa y atómica a la función RPC respetando el RLS del usuario autenticado
        const { error } = await supabase.rpc('crear_cliente_y_prestamo', {
          p_nombre: nombre.trim(),
          p_apellido: apellido.trim(),
          p_whatsapp: whatsapp.trim(),
          p_correo: correo ? correo.trim() : null,
          p_notas: notas ? notas.trim() : null,
          p_monto: monto,
          p_tasa: tasa,
          p_fecha_entrega: fecha_entrega,
          p_metodo_pago: metodo_pago
        });

        if (error) throw error;

        // Éxito: Redirigir al dashboard
        window.location.href = '/';

      } catch (err: any) {
        if (errorBox) {
          errorBox.textContent = err.message || 'Error al procesar el registro.';
          errorBox.style.display = 'block';
        }
        btnSubmit.textContent = 'Registrar y Desembolsar';
        btnSubmit.removeAttribute('disabled');
      }
    });
  </script>
  

  <style>
    .form-wrapper {
      max-width: 600px;
      margin: 0 auto;
    }

    .form-header {
      margin-bottom: 1.25rem;
    }

    .back-link {
      font-size: 0.813rem;
      color: var(--accent);
      text-decoration: none;
    }

    .form-header h1 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
      margin-top: 0.25rem;
    }

    .alert-error {
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.813rem;
      margin-bottom: 1rem;
    }

    .form-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .form-section {
      border: none;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .form-section legend {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
      width: 100%;
      padding-bottom: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .calc-preview {
      background-color: var(--bg-main);
      border: 1px solid var(--border-color);
      border-radius: 0.5rem;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .calc-label {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .calc-value-yellow {
      font-size: 1rem;
      font-weight: 600;
      color: #fbbf24;
      display: block;
    }

    .calc-value-green {
      font-size: 1rem;
      font-weight: 600;
      color: var(--accent);
      display: block;
    }

    .calc-value-white {
      font-size: 0.875rem;
      font-weight: 500;
      color: #fff;
      display: block;
    }

    .form-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--border-color);
    }

    @media (min-width: 640px) {
      .form-header h1 {
        font-size: 1.5rem;
      }
      .calc-preview {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
      .form-actions {
        flex-direction: row;
        justify-content: flex-end;
      }
    }
  </style>
</LayoutAdmin>