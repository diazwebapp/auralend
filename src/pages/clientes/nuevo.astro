---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';

const cedulaInicial = Astro.url.searchParams.get('cedula') || '';
---

<LayoutAdmin title="Registrar Cliente - Auralend">
  <div class="cli-nuevo-wrap">
    <div class="top-nav">
      <a href="/prestamos/nuevo" class="back-link">&larr; Cambiar cédula</a>
      <a href="/" class="btn-ghost">Cartera</a>
    </div>

    <div class="panel">
      <h3>CÉDULA NUEVA — REGISTRAR CLIENTE</h3>

      <form id="form-crear-cliente" class="grid-2">
        <div class="form-group col-span-2">
          <label for="cli-cedula">Cédula *</label>
          <input
            type="text"
            id="cli-cedula"
            value={cedulaInicial}
            required
            placeholder="Ej. 23413903"
          />
        </div>

        <div class="form-group">
          <label for="cli-nombre">Nombre *</label>
          <input type="text" id="cli-nombre" required placeholder="Nombre" autofocus />
        </div>

        <div class="form-group">
          <label for="cli-apellido">Apellido *</label>
          <input type="text" id="cli-apellido" required placeholder="Apellido" />
        </div>

        <div class="form-group">
          <label for="cli-whatsapp">WhatsApp</label>
          <input type="text" id="cli-whatsapp" placeholder="Ej. +584140000000" />
        </div>

        <div class="form-group">
          <label for="cli-correo">Correo (Opcional)</label>
          <input type="email" id="cli-correo" placeholder="correo@ejemplo.com" />
        </div>

        <div id="cli-error" class="alert-error col-span-2" style="display: none;"></div>

        <div class="col-span-2 actions-end">
          <button type="submit" id="btn-guardar-cliente" class="btn-primary">
            Guardar y Continuar al Préstamo &rarr;
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const form = document.getElementById('form-crear-cliente') as HTMLFormElement | null;
    const btn = document.getElementById('btn-guardar-cliente') as HTMLButtonElement | null;
    const errBox = document.getElementById('cli-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errBox) errBox.style.display = 'none';

      const cedula =
        (document.getElementById('cli-cedula') as HTMLInputElement | null)?.value.trim() || '';
      const nombre =
        (document.getElementById('cli-nombre') as HTMLInputElement | null)?.value.trim() || '';
      const apellido =
        (document.getElementById('cli-apellido') as HTMLInputElement | null)?.value.trim() || '';
      const whatsapp =
        (document.getElementById('cli-whatsapp') as HTMLInputElement | null)?.value.trim() || '';
      const correo =
        (document.getElementById('cli-correo') as HTMLInputElement | null)?.value.trim() || '';

      try {
        if (!cedula || !nombre || !apellido) {
          throw new Error('Cédula, nombre y apellido son obligatorios.');
        }

        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Guardando cliente...';
        }

        const { data: sessionData } = await supabase.auth.getSession();
        const token = sessionData.session?.access_token;
        if (!token) throw new Error('No hay sesión activa.');

        const res = await fetch('/api/clientes/crear', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            cedula,
            nombre,
            apellido,
            whatsapp: whatsapp || null,
            correo: correo || null,
          }),
        });

        const raw = await res.text();
        let json: any;
        try {
          json = JSON.parse(raw);
        } catch {
          throw new Error(`Respuesta inválida (${res.status}) al registrar el cliente.`);
        }

        if (!res.ok || !json?.success) {
          throw new Error(json?.error || `Error HTTP ${res.status}`);
        }

        const nuevoClienteId = json.data?.id || json.data?.cliente_id;
        if (!nuevoClienteId) {
          throw new Error('El servidor no devolvió el UUID del cliente creado.');
        }

        window.location.href = `/prestamos/nuevo/${encodeURIComponent(String(nuevoClienteId))}`;
      } catch (err) {
        if (errBox) {
          errBox.textContent =
            err instanceof Error ? err.message : 'Error al registrar el cliente.';
          errBox.style.display = 'block';
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Guardar y Continuar al Préstamo →';
        }
      }
    });
  </script>

  <style>
    .cli-nuevo-wrap {
      max-width: 760px;
      margin: 0 auto;
      color: #f9fafb;
    }
    .top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .back-link {
      font-size: 0.82rem;
      color: #34d399;
      text-decoration: none;
    }
    .btn-ghost {
      background: #1f2937;
      color: #e5e7eb;
      border: 1px solid #374151;
      padding: 0.35rem 0.7rem;
      border-radius: 0.375rem;
      font-size: 0.78rem;
      text-decoration: none;
    }
    .panel {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 0.65rem;
      padding: 1.2rem;
    }
    .panel h3 {
      margin: 0 0 1rem 0;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      color: #9ca3af;
      border-bottom: 1px solid #1f2937;
      padding-bottom: 0.55rem;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.95rem;
    }
    @media (min-width: 640px) {
      .grid-2 {
        grid-template-columns: repeat(2, 1fr);
      }
      .col-span-2 {
        grid-column: span 2;
      }
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    label {
      font-size: 0.8rem;
      color: #d1d5db;
    }
    input {
      background: #0b1120;
      color: #f9fafb;
      border: 1px solid #374151;
      border-radius: 0.375rem;
      padding: 0.55rem 0.75rem;
    }
    .actions-end {
      display: flex;
      justify-content: flex-end;
      margin-top: 0.25rem;
    }
    .btn-primary {
      background: #10b981;
      color: #06281e;
      border: none;
      padding: 0.6rem 1.05rem;
      border-radius: 0.375rem;
      font-weight: 700;
      cursor: pointer;
    }
    .alert-error {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.45);
      color: #fca5a5;
      padding: 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.82rem;
    }
  </style>
</LayoutAdmin>