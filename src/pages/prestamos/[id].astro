---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { createClient } from '@supabase/supabase-js';
import { renderizarContratoHtml } from '../../lib/plantillaContrato';

const { id } = Astro.params;
const token = Astro.cookies.get('sb-access-token')?.value;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

let errorSSR: string | null = null;
let prestamo: any = null;
let cliente: any = null;
let listaMovimientos: any[] = [];
let comprobantePorMovimiento: Record<string, string> = {};
let contratoHtmlSSR: string = '';

if (!id) {
  errorSSR = 'Falta el ID del préstamo en la URL.';
} else if (!token) {
  errorSSR = 'No se encontró la cookie sb-access-token en el servidor. Verifica que se guarde al iniciar sesión.';
} else {
  const supabaseServer = createClient(supabaseUrl, supabaseKey, {
    global: {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    },
    auth: { persistSession: false },
  });

  const { data: { user }, error: userError } = await supabaseServer.auth.getUser(token);

  if (userError || !user) {
    errorSSR = `Sesión inválida en SSR: ${userError?.message || 'usuario no encontrado'}.`;
  } else {
    const { data: pData, error: pError } = await supabaseServer
      .from('prestamos')
      .select('*')
      .eq('id', id)
      .single();

    if (pError || !pData) {
      errorSSR = `No se pudo leer el préstamo (${id}): ${pError?.message || 'sin datos'}.`;
    } else {
      prestamo = pData;

      const { data: cData, error: cError } = await supabaseServer
        .from('clientes')
        .select('*')
        .eq('id', prestamo.cliente_id)
        .single();

      if (cError || !cData) {
        errorSSR = `No se pudo leer el cliente (${prestamo.cliente_id}): ${cError?.message || 'sin datos'}.`;
      } else {
        cliente = cData;

        const { data: mData } = await supabaseServer
          .from('movimientos')
          .select('*')
          .eq('prestamo_id', id)
          .order('creado_en', { ascending: false });

        listaMovimientos = mData ?? [];

        const { data: dData } = await supabaseServer
          .from('documentos_prestamo')
          .select('id, movimiento_id, tipo_documento, creado_en')
          .eq('prestamo_id', id)
          .eq('tipo_documento', 'capture_pago')
          .order('creado_en', { ascending: false });

        for (const doc of dData ?? []) {
          if (doc.movimiento_id && !comprobantePorMovimiento[doc.movimiento_id]) {
            comprobantePorMovimiento[doc.movimiento_id] = doc.id;
          }
        }

        const montoNum = Number(prestamo.monto_acreditado || 0);
        const capitalNum = Number(prestamo.capital_restante ?? montoNum);
        const interesNum = Number(prestamo.interes_pendiente_ciclo || 0);
        const tasaNum = Number(prestamo.tasa_interes || 20);
        const nombreCompleto = `${cliente.nombre || ''} ${cliente.apellido || ''}`.trim() || 'Cliente';

        contratoHtmlSSR = renderizarContratoHtml({
          prestamoId: String(prestamo.id),
          adminNombre: user.email || 'Administración',
          clienteNombre: nombreCompleto,
          clienteCedula: cliente.cedula ?? 'No registrada',
          clienteWhatsapp: cliente.whatsapp || 'No registrado',
          clienteCorreo: cliente.correo || 'No registrado',
          garantiaNotas: cliente.notas || 'Sin garantía adicional registrada',
          montoAcreditado: `$${montoNum.toFixed(2)}`,
          capitalRestante: `$${capitalNum.toFixed(2)}`,
          interesCiclo: `$${interesNum.toFixed(2)} (${tasaNum}%)`,
          modalidadPago: 'Según cronograma acordado',
          fechaEmision: prestamo.fecha_entrega || new Date().toISOString().split('T')[0],
          fechaProximoPago: prestamo.fecha_proximo_pago
            ? new Date(prestamo.fecha_proximo_pago).toLocaleDateString('es-ES')
            : 'Por definir',
        });
      }
    }
  }
}

const estadoActual = String(prestamo?.estado || 'pendiente');

const totalRecargosHistoricos = listaMovimientos
  .filter((m) => String(m.tipo_movimiento).toUpperCase() === 'RECARGO')
  .reduce((acc, m) => acc + Number(m.monto_total || 0), 0);

const totalPagadoAInteres = listaMovimientos
  .filter((m) => String(m.tipo_movimiento).toUpperCase().startsWith('PAGO'))
  .reduce((acc, m) => acc + Number(m.aplicado_a_interes || 0), 0);

const recargoPendiente = Math.max(
  0,
  Number((totalRecargosHistoricos - totalPagadoAInteres).toFixed(2))
);
---

<LayoutAdmin title="Detalle del Préstamo - Auralend">
  <div id="detail-app" class="detail-wrapper" data-prestamo-id={id}>
    <div class="detail-header">
      <div class="header-top-row">
        <button type="button" id="btn-atras-historia" class="back-link">
          &larr; Atrás
        </button>

        {!errorSSR && prestamo && cliente && (
          <div class="header-actions">
            <a
              href={`/clientes/${encodeURIComponent(String(cliente.id))}`}
              class="btn-cliente-link"
            >
              Ficha del cliente
            </a>
            <button type="button" id="btn-ver-contrato" class="btn-contrato">
              Ver contrato HTML
            </button>
          </div>
        )}
      </div>

      <div class="title-status-row">
        <div>
          <h1>Gestión de Crédito y Pagos</h1>
          {!errorSSR && cliente && (
            <p class="subtitulo-cliente">
              {cliente.nombre} {cliente.apellido} · Cédula: <strong>{cliente.cedula ?? '—'}</strong>
            </p>
          )}
        </div>

        {!errorSSR && prestamo && (
          <div class="estado-control-box">
            <span class="badge-estado" id="badge-estado-prestamo">{estadoActual}</span>

            <select id="select-estado-prestamo" class="select-estado" aria-label="Estado del préstamo">
              <option value="pendiente" selected={estadoActual === 'pendiente'}>pendiente</option>
              <option value="activo" selected={estadoActual === 'activo'}>activo</option>
              <option value="pagado" selected={estadoActual === 'pagado'}>pagado</option>
              <option value="vencido" selected={estadoActual === 'vencido'}>vencido</option>
              <option value="en_mora" selected={estadoActual === 'en_mora'}>en_mora</option>
            </select>

            <button type="button" id="btn-guardar-estado" class="btn-estado">
              Actualizar estado
            </button>
          </div>
        )}
      </div>
      <div id="estado-feedback" class="estado-feedback" style="display: none;"></div>
    </div>

    {errorSSR ? (
      <div class="panel-oscuro alert-error">
        <strong>Error al cargar el detalle:</strong> {errorSSR}
      </div>
    ) : (
      <div class="space-y-4">
        <div id="visor-contrato-panel" class="panel-claro contrato-card" style="display: none;">
          <div class="contrato-toolbar">
            <h3>Contrato del Préstamo</h3>
            <div class="contrato-toolbar-actions">
              <button type="button" id="btn-imprimir-contrato-detalle" class="btn-primary">
                Imprimir / Guardar PDF
              </button>
              <button type="button" id="btn-cerrar-contrato-detalle" class="btn-secondary-sm">
                Ocultar
              </button>
            </div>
          </div>
          <div id="contrato-html-body" class="contrato-html-box" set:html={contratoHtmlSSR} />
        </div>

        <div class="panel-oscuro stats-card">
          <h3>Estado Financiero Actual</h3>
          <div class="stats-grid">
            <div class="stat-box">
              <span class="label">Capital Restante</span>
              <span class="stat-green">${Number(prestamo.capital_restante).toFixed(2)}</span>
            </div>
            <div class="stat-box">
              <span class="label">Interés Pendiente (Ciclo)</span>
              <span class="stat-yellow">${Number(prestamo.interes_pendiente_ciclo).toFixed(2)}</span>
            </div>
            <div class="stat-box">
              <span class="label">Recargos por Atraso</span>
              <span class={recargoPendiente > 0 ? 'stat-red' : 'valor-muted'}>
                ${recargoPendiente.toFixed(2)}
              </span>
            </div>
            <div class="stat-box">
              <span class="label">Próximo Pago / Corte</span>
              <span class="valor-claro">{new Date(prestamo.fecha_proximo_pago).toLocaleDateString('es-ES')}</span>
            </div>
          </div>
        </div>

        <div class="panel-oscuro payment-card">
          <h3>Registrar Nuevo Abono</h3>
          <form id="form-pago" class="payment-form">
            <div class="form-group">
              <label for="pago-monto">Monto a Pagar (USDT / Divisa) *</label>
              <input type="number" id="pago-monto" step="0.01" min="0.01" required placeholder="Ej. 20.00" />
              <small class="valor-muted">El sistema aplicará el pago primero al interés pendiente y el excedente a capital.</small>
            </div>

            <div class="form-group">
              <label for="pago-metodo">Método de Pago</label>
              <select id="pago-metodo">
                <option value="USDT - Binance Pay">USDT - Binance Pay</option>
                <option value="USDT - TRC20">USDT - TRC20</option>
                <option value="Efectivo USD">Efectivo USD</option>
                <option value="Zinli / Wally">Zinli / Wally</option>
                <option value="Pago Móvil / Bolívares">Pago Móvil / Bolívares</option>
              </select>
            </div>

            <div class="form-group">
              <label for="pago-referencia">Referencia o Comprobante (Opcional)</label>
              <input type="text" id="pago-referencia" placeholder="Hash de transacción o número..." />
            </div>

            <div class="form-group">
              <label for="pago-capture">Capture / Comprobante de Pago (Opcional)</label>
              <input
                type="file"
                id="pago-capture"
                accept="image/jpeg,image/png,image/webp"
              />
              <small class="valor-muted">Ideal para transferencias o pagos cripto cuando no se tiene el hash a mano (máx. 5 MB).</small>
            </div>

            <div id="pago-error" class="alert-error" style="display: none;"></div>

            <button type="submit" id="btn-pagar" class="btn-primary w-full">Aplicar Abono</button>
          </form>
        </div>

        <div class="panel-oscuro history-card">
          <h3>Historial de Movimientos</h3>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Tipo</th>
                  <th>Total</th>
                  <th>A Interés</th>
                  <th>A Capital</th>
                  <th>Comprobante</th>
                  <th>Método</th>
                </tr>
              </thead>
              <tbody>
                {listaMovimientos.length > 0 ? (
                  listaMovimientos.map((m) => (
                    <tr>
                      <td>{new Date(m.creado_en).toLocaleDateString('es-ES')}</td>
                      <td><span class={`badge-${String(m.tipo_movimiento).toLowerCase()}`}>{m.tipo_movimiento}</span></td>
                      <td>${Number(m.monto_total).toFixed(2)}</td>
                      <td class="text-yellow">+${Number(m.aplicado_a_interes).toFixed(2)}</td>
                      <td class="text-green">+${Number(m.aplicado_a_capital).toFixed(2)}</td>
                      <td>
                        {m.id && comprobantePorMovimiento[m.id] ? (
                          <button
                            type="button"
                            class="btn-ver-comprobante"
                            data-doc-id={comprobantePorMovimiento[m.id]}
                            data-movimiento-id={m.id}
                          >
                            Ver comprobante
                          </button>
                        ) : (
                          <span class="valor-muted">—</span>
                        )}
                      </td>
                      <td>{m.metodo_pago || 'N/A'}</td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colspan="7" class="text-center valor-muted">No hay movimientos registrados.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const appEl = document.getElementById('detail-app');
    const prestamoId = appEl?.dataset.prestamoId;

    const btnAtras = document.getElementById('btn-atras-historia');
    btnAtras?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    });

    const formPago = document.getElementById('form-pago');
    const btnPagar = document.getElementById('btn-pagar');
    const pagoError = document.getElementById('pago-error');

    const btnVerContrato = document.getElementById('btn-ver-contrato');
    const btnCerrarContrato = document.getElementById('btn-cerrar-contrato-detalle');
    const btnImprimirContrato = document.getElementById('btn-imprimir-contrato-detalle');
    const visorContratoPanel = document.getElementById('visor-contrato-panel');
    const contratoHtmlBody = document.getElementById('contrato-html-body');

    const selectEstado = document.getElementById('select-estado-prestamo');
    const btnGuardarEstado = document.getElementById('btn-guardar-estado');
    const badgeEstado = document.getElementById('badge-estado-prestamo');
    const estadoFeedback = document.getElementById('estado-feedback');

    function mostrarEstadoFeedback(mensaje: string, esError = false) {
      if (!estadoFeedback) return;
      estadoFeedback.textContent = mensaje;
      estadoFeedback.style.display = 'block';
      estadoFeedback.className = esError ? 'estado-feedback error' : 'estado-feedback ok';
    }

    btnGuardarEstado?.addEventListener('click', async () => {
      if (!prestamoId || !selectEstado || !('value' in selectEstado)) return;
      const nuevoEstado = String(selectEstado.value);

      btnGuardarEstado.setAttribute('disabled', 'true');
      btnGuardarEstado.textContent = 'Guardando...';

      try {
        const { data: sessionData } = await supabase.auth.getSession();
        if (!sessionData.session) {
          throw new Error('No hay sesión activa para cambiar el estado.');
        }

        const { error } = await supabase
          .from('prestamos')
          .update({ estado: nuevoEstado })
          .eq('id', prestamoId);

        if (error) {
          throw new Error(error.message);
        }

        if (badgeEstado) {
          badgeEstado.textContent = nuevoEstado;
        }
        mostrarEstadoFeedback(`Estado actualizado a "${nuevoEstado}".`, false);
      } catch (err) {
        mostrarEstadoFeedback(
          err instanceof Error ? err.message : 'No se pudo actualizar el estado.',
          true
        );
      } finally {
        btnGuardarEstado.removeAttribute('disabled');
        btnGuardarEstado.textContent = 'Actualizar estado';
      }
    });

    function obtenerHtmlContrato(): string {
      if (prestamoId) {
        try {
          const cached = sessionStorage.getItem(`contrato_html_${prestamoId}`);
          if (cached && cached.trim()) {
            return cached;
          }
        } catch {
          // Ignorar errores de acceso a sessionStorage
        }
      }
      return contratoHtmlBody?.innerHTML || '';
    }

    btnVerContrato?.addEventListener('click', () => {
      if (!visorContratoPanel) return;
      const htmlGuardado = obtenerHtmlContrato();
      if (contratoHtmlBody && htmlGuardado && !contratoHtmlBody.innerHTML.trim()) {
        contratoHtmlBody.innerHTML = htmlGuardado;
      }
      visorContratoPanel.style.display = 'block';
      visorContratoPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    btnCerrarContrato?.addEventListener('click', () => {
      if (visorContratoPanel) {
        visorContratoPanel.style.display = 'none';
      }
    });

    btnImprimirContrato?.addEventListener('click', () => {
      const htmlContenido = obtenerHtmlContrato();
      const ventana = window.open('', '_blank', 'width=860,height=720');
      if (!ventana) {
        window.print();
        return;
      }
      ventana.document.open();
      ventana.document.write(htmlContenido);
      ventana.document.close();
      ventana.focus();
      setTimeout(() => {
        ventana.print();
      }, 250);
    });

    function extraerMovimientoId(payload: any): string | null {
      if (!payload || typeof payload !== 'object') return null;
      if (typeof payload.movimiento_id === 'string') return payload.movimiento_id;
      if (typeof payload.id === 'string') return payload.id;
      if (payload.movimiento && typeof payload.movimiento.id === 'string') return payload.movimiento.id;
      return null;
    }

    formPago?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (pagoError) pagoError.style.display = 'none';
      if (btnPagar) {
        btnPagar.textContent = 'Procesando pago...';
        btnPagar.setAttribute('disabled', 'true');
      }

      const montoEl = document.getElementById('pago-monto');
      const metodoEl = document.getElementById('pago-metodo');
      const captureEl = document.getElementById('pago-capture');

      const monto = parseFloat(
        montoEl && 'value' in montoEl ? String(montoEl.value).replace(',', '.') : '0'
      );
      const metodo =
        metodoEl && 'value' in metodoEl ? String(metodoEl.value) : 'USDT - Binance Pay';
      const archivo =
        captureEl && 'files' in captureEl && captureEl.files && captureEl.files.length > 0
          ? captureEl.files[0]
          : null;

      try {
        if (!prestamoId) throw new Error('No se encontró el ID del préstamo.');
        if (!Number.isFinite(monto) || monto <= 0) {
          throw new Error('Ingresa un monto válido mayor a 0.');
        }

        const { data } = await supabase.auth.getSession();
        const token = data.session?.access_token;
        if (!token) throw new Error('No hay sesión activa.');

        const resPago = await fetch(`/api/prestamos/${prestamoId}/pagar`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ monto, metodo }),
        });

        const rawPago = await resPago.text();
        let jsonPago;
        try {
          jsonPago = JSON.parse(rawPago);
        } catch {
          throw new Error(`Respuesta inválida (${resPago.status}) al registrar el pago.`);
        }

        if (!resPago.ok || !jsonPago?.success) {
          throw new Error(jsonPago?.error || `Error HTTP ${resPago.status}`);
        }

        if (archivo) {
          if (btnPagar) btnPagar.textContent = 'Subiendo comprobante...';

          const fd = new FormData();
          fd.append('archivo', archivo);

          const movId = extraerMovimientoId(jsonPago.data);
          if (movId) {
            fd.append('movimiento_id', movId);
          }

          const resComp = await fetch(`/api/prestamos/${prestamoId}/comprobante`, {
            method: 'POST',
            headers: {
              Authorization: `Bearer ${token}`,
            },
            body: fd,
          });

          const rawComp = await resComp.text();
          let jsonComp;
          try {
            jsonComp = JSON.parse(rawComp);
          } catch {
            throw new Error(`Pago registrado, pero hubo un error (${resComp.status}) al subir el capture.`);
          }

          if (!resComp.ok || !jsonComp?.success) {
            throw new Error(
              `Pago registrado, pero falló el capture: ${jsonComp?.error || `HTTP ${resComp.status}`}`
            );
          }
        }

        window.location.reload();
      } catch (err) {
        if (pagoError) {
          pagoError.textContent = err instanceof Error ? err.message : 'Error al procesar el abono.';
          pagoError.style.display = 'block';
        }
        if (btnPagar) {
          btnPagar.textContent = 'Aplicar Abono';
          btnPagar.removeAttribute('disabled');
        }
      }
    });

    document.addEventListener('click', async (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;

      const btn = target.closest('.btn-ver-comprobante');
      if (!(btn instanceof HTMLElement)) return;

      const docId = btn.dataset.docId;
      const movId = btn.dataset.movimientoId;
      if (!prestamoId || (!docId && !movId)) return;

      const textoOriginal = btn.textContent || 'Ver comprobante';
      btn.textContent = 'Abriendo...';
      btn.setAttribute('disabled', 'true');

      try {
        const { data } = await supabase.auth.getSession();
        const token = data.session?.access_token;
        if (!token) throw new Error('No hay sesión activa.');

        const params = new URLSearchParams();
        if (docId) params.set('doc_id', docId);
        if (movId) params.set('movimiento_id', movId);

        const res = await fetch(`/api/prestamos/${prestamoId}/comprobante?${params.toString()}`, {
          method: 'GET',
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const json = await res.json();
        if (!res.ok || !json?.success || !json?.data?.url) {
          throw new Error(json?.error || 'No se pudo cargar el comprobante.');
        }

        window.open(json.data.url, '_blank', 'noopener,noreferrer');
      } catch (err) {
        if (pagoError) {
          pagoError.textContent =
            err instanceof Error ? err.message : 'Error al abrir el comprobante.';
          pagoError.style.display = 'block';
        }
      } finally {
        btn.textContent = textoOriginal;
        btn.removeAttribute('disabled');
      }
    });
  </script>

  <style>
    .detail-wrapper {
      max-width: 820px;
      margin: 0 auto;
      color: #f9fafb;
    }
    .detail-header {
      margin-bottom: 1.5rem;
    }
    .header-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .header-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .back-link {
      background: transparent;
      border: none;
      padding: 0.25rem 0;
      font-size: 0.813rem;
      color: #34d399;
      cursor: pointer;
      font-weight: 600;
    }
    .back-link:hover {
      text-decoration: underline;
    }
    .btn-cliente-link {
      background: #1f2937;
      border: 1px solid #374151;
      color: #e5e7eb;
      padding: 0.45rem 0.85rem;
      border-radius: 0.375rem;
      font-size: 0.813rem;
      font-weight: 600;
      text-decoration: none;
    }
    .btn-cliente-link:hover {
      background: #374151;
    }
    .title-status-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }
    .subtitulo-cliente {
      margin: 0.2rem 0 0 0;
      font-size: 0.82rem;
      color: #9ca3af;
    }
    .estado-control-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .badge-estado {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      border: 1px solid #374151;
      background: #1f2937;
      color: #fbbf24;
    }
    .select-estado {
      background: #0b1120;
      color: #f9fafb;
      border: 1px solid #374151;
      border-radius: 0.375rem;
      padding: 0.35rem 0.6rem;
      font-size: 0.813rem;
    }
    .btn-estado {
      background: #1f2937;
      color: #f9fafb;
      border: 1px solid #4b5563;
      padding: 0.35rem 0.75rem;
      border-radius: 0.375rem;
      font-size: 0.813rem;
      font-weight: 600;
      cursor: pointer;
