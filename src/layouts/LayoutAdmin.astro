---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="app-container">
      <!-- Navbar Mobile First -->
      <header class="navbar">
        <div class="nav-brand">
          <span class="brand-dot"></span>
          <h2>Préstamos</h2>
        </div>
        <nav class="nav-actions">
          <a href="/" class="nav-link">Inicio</a>
          <a href="/clientes/nuevo" class="btn-primary">+ Crédito</a>
          <button id="btn-logout" class="btn-secondary">Salir</button>
        </nav>
      </header>

      <!-- Contenido Principal -->
      <main class="main-content">
        <slot />
      </main>
    </div>

    <script>
      import { supabase } from '../lib/supabase';
      
      const btnLogout = document.getElementById('btn-logout');
      btnLogout?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/login';
      });
    </script>

    <style>
      :root {
        --bg-main: #09090b;
        --bg-card: #121217;
        --bg-input: #18181b;
        --border-color: #27272a;
        --text-main: #f4f4f5;
        --text-muted: #a1a1aa;
        --accent: #10b981;
        --accent-hover: #059669;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--bg-main);
        color: var(--text-main);
        min-height: 100vh;
        line-height: 1.5;
      }

      /* MOBILE FIRST: Contenedor fluido en móviles */
      .app-container {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem;
      }

      @media (min-width: 768px) {
        .app-container {
          padding: 2rem 1.5rem;
        }
      }

      /* NAVBAR MOBILE FIRST: Apilado en móvil, en línea en desktop */
      .navbar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1.5rem;
      }

      @media (min-width: 640px) {
        .navbar {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          padding-bottom: 1.25rem;
          margin-bottom: 2rem;
        }
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .brand-dot {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
      }

      .navbar h2 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-main);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .nav-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.813rem;
        font-weight: 500;
        padding: 0.4rem 0.6rem;
      }

      .nav-link:hover {
        color: var(--text-main);
      }

      /* Botones adaptados para toque móvil */
      .btn-primary {
        background-color: var(--accent);
        color: #fff;
        padding: 0.5rem 0.875rem;
        border-radius: 0.5rem;
        font-size: 0.813rem;
        font-weight: 500;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s;
        text-align: center;
      }

      .btn-primary:hover {
        background-color: var(--accent-hover);
      }

      .btn-secondary {
        background-color: var(--bg-input);
        color: var(--text-muted);
        padding: 0.5rem 0.875rem;
        border-radius: 0.5rem;
        font-size: 0.813rem;
        font-weight: 500;
        border: 1px solid var(--border-color);
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-secondary:hover {
        background-color: var(--border-color);
        color: var(--text-main);
      }

      /* Utilidades globales */
      .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        padding: 1rem;
      }

      @media (min-width: 768px) {
        .card {
          padding: 1.5rem;
        }
      }

      input, select, textarea {
        background-color: var(--bg-input);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        width: 100%;
        font-family: inherit;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--accent);
      }

      label {
        display: block;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.375rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
      }
    </style>
  </body>
</html>