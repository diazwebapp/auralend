---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { createClient } from '@supabase/supabase-js';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const token = Astro.cookies.get('sb-access-token')?.value;
if (!token) {
  return Astro.redirect('/');
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

const supabaseServer = createClient(supabaseUrl, supabaseKey, {
  global: {
    headers: {
      Authorization: `Bearer ${token}`,
    },
  },
  auth: { persistSession: false },
});

const { data: { user } } = await supabaseServer.auth.getUser(token);
if (!user) {
  return Astro.redirect('/');
}

const { data: prestamo, error: pError } = await supabaseServer
  .from('prestamos')
  .select('*')
  .eq('id', id)
  .single();

if (pError || !prestamo) {
  return Astro.redirect('/');
}

const { data: cliente, error: cError } = await supabaseServer
  .from('clientes')
  .select('*')
  .eq('id', prestamo.cliente_id)
  .single();

if (cError || !cliente) {
  return Astro.redirect('/');
}

const { data: movimientos } = await supabaseServer
  .from('movimientos')
  .select('*')
  .eq('prestamo_id', id)
  .order('creado_en', { ascending: false });

const listaMovimientos = movimientos ?? [];
const whatsappClean = String(cliente.whatsapp || '').replace(/[^0-9]/g, '');
---

<LayoutAdmin title="Detalle del Préstamo - Sistema de Préstamos">
  <div id="detail-app" class="detail-wrapper" data-prestamo-id={id}>
    <div class="detail-header">
      <a href="/" class="back-link">&larr; Volver a la cartera</a>
      <h1>Gestión de Crédito y Pagos</h1>
    </div>

    <div class="space-y-4">
      <div class="card info-card">
        <h3>Información del Cliente</h3>
        <div class="info-grid">
          <div>
            <span class="label">Cliente</span>
            <strong class="text-white">{cliente.nombre} {cliente.apellido}</strong>
          </div>
          <div>
            <span class="label">WhatsApp</span>
            <a href={`https://wa.me/${whatsappClean}`} target="_blank" rel="noopener noreferrer" class="whatsapp-link">
              📱 {cliente.whatsapp}
            </a>
          </div>
          <div>
            <span class="label">Notas / Garantía</span>
            <span class="text-muted">{cliente.notas || 'Sin notas ni garantías registradas.'}</span>
          </div>
        </div>
      </div>

      <div class="card stats-card">
        <h3>Estado Financiero Actual</h3>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="label">Capital Restante</span>
            <span class="stat-green">${Number(prestamo.capital_restante).toFixed(2)}</span>
          </div>
          <div class="stat-box">
            <span class="label">Interés Pendiente (Ciclo)</span>
            <span class="stat-yellow">${Number(prestamo.interes_pendiente_ciclo).toFixed(2)}</span>
          </div>
          <div class="stat-box">
            <span class="label">Próximo Pago / Corte</span>
            <span class="text-white">{new Date(prestamo.fecha_proximo_pago).toLocaleDateString('es-ES')}</span>
          </div>
        </div>
      </div>

      <div class="card payment-card">
        <h3>Registrar Nuevo Abono</h3>
        <form
  id="form-pago"
  action={`/api/prestamos/${id}/pagar`}
  method="post"
  class="payment-form"
>
  <div class="form-group">
    <label for="pago-monto">Monto a Pagar (USDT / Divisa) *</label>
    <input
      type="number"
      id="pago-monto"
      name="monto"
      step="0.01"
      min="0.01"
      required
      placeholder="Ej. 20.00"
    />
    <small class="text-muted">El sistema aplicará el pago primero al interés pendiente y el excedente a capital.</small>
  </div>

  <div class="form-group">
    <label for="pago-metodo">Método de Pago</label>
    <select id="pago-metodo" name="metodo">
      <option value="USDT - Binance Pay">USDT - Binance Pay</option>
      <option value="USDT - TRC20">USDT - TRC20</option>
      <option value="Efectivo USD">Efectivo USD</option>
      <option value="Zinli / Wally">Zinli / Wally</option>
      <option value="Pago Móvil / Bolívares">Pago Móvil / Bolívares</option>
    </select>
  </div>

  <div class="form-group">
    <label for="pago-referencia">Referencia o Comprobante (Opcional)</label>
    <input
      type="text"
      id="pago-referencia"
      name="referencia"
      placeholder="Hash de transacción o número..."
    />
  </div>



  <button type="submit" id="btn-pagar" class="btn-primary w-full">Aplicar Abono</button>
</form>
      </div>

      <div class="card history-card">
        <h3>Historial de Movimientos</h3>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Total</th>
                <th>A Interés</th>
                <th>A Capital</th>
                <th>Método</th>
              </tr>
            </thead>
            <tbody>
              {listaMovimientos.length > 0 ? (
                listaMovimientos.map((m) => (
                  <tr>
                    <td>{new Date(m.creado_en).toLocaleDateString('es-ES')}</td>
                    <td><span class={`badge-${String(m.tipo_movimiento).toLowerCase()}`}>{m.tipo_movimiento}</span></td>
                    <td>${Number(m.monto_total).toFixed(2)}</td>
                    <td class="text-yellow">+${Number(m.aplicado_a_interes).toFixed(2)}</td>
                    <td class="text-green">+${Number(m.aplicado_a_capital).toFixed(2)}</td>
                    <td>{m.metodo_pago || 'N/A'}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="6" class="text-center text-muted">No hay movimientos registrados.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const appEl = document.getElementById('detail-app');
    const prestamoId = appEl?.dataset.prestamoId;

    const formPago = document.getElementById('form-pago');
    const btnPagar = document.getElementById('btn-pagar');
    const pagoError = document.getElementById('pago-error');

    formPago?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (pagoError) pagoError.style.display = 'none';
      if (btnPagar) {
        btnPagar.textContent = 'Procesando pago...';
        btnPagar.setAttribute('disabled', 'true');
      }

      const montoEl = document.getElementById('pago-monto');
      const metodoEl = document.getElementById('pago-metodo');
      const referenciaEl = document.getElementById('pago-referencia');

      const monto = parseFloat(montoEl && 'value' in montoEl ? montoEl.value : '0');
      const metodo = metodoEl && 'value' in metodoEl ? metodoEl.value : 'USDT - Binance Pay';
      const referencia = referenciaEl && 'value' in referenciaEl ? referenciaEl.value : '';

      /* try {
        const { data } = await supabase.auth.getSession();
        const token = data.session?.access_token;
        if (!token) {
          throw new Error('No hay sesión activa.');
        }

        const res = await fetch(`/api/prestamos/${prestamoId}/pagar`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ monto, metodo, referencia }),
        });

        const json = await res.json();
        if (!res.ok || !json.success) {
          throw new Error(json.error || 'No se pudo registrar el pago.');
        }

        window.location.reload();
      } catch (err) {
        if (pagoError) {
          pagoError.textContent = err instanceof Error ? err.message : 'Error al registrar el pago.';
          pagoError.style.display = 'block';
        }
        if (btnPagar) {
          btnPagar.textContent = 'Aplicar Abono';
          btnPagar.removeAttribute('disabled');
        }
      } */
    });
  </script>

  <style>
    .detail-wrapper { max-width: 800px; margin: 0 auto; }
    .detail-header { margin-bottom: 1.5rem; }
    .back-link { font-size: 0.813rem; color: var(--accent); text-decoration: none; }
    .detail-header h1 { font-size: 1.25rem; font-weight: 700; color: #fff; margin-top: 0.25rem; }
    .space-y-4 > * + * { margin-top: 1rem; }
    .info-card h3, .stats-card h3, .payment-card h3, .history-card h3 {
      font-size: 0.875rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 1rem;
      border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;
    }
    .info-grid, .stats-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    @media (min-width: 640px) {
      .info-grid, .stats-grid { grid-template-columns: repeat(3, 1fr); }
      .detail-header h1 { font-size: 1.5rem; }
    }
    .label { display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.25rem; text-transform: uppercase; }
    .whatsapp-link { color: var(--accent); text-decoration: none; font-weight: 500; }
    .stat-box { background-color: var(--bg-main); padding: 0.75rem; border-radius: 0.5rem; border: 1px solid var(--border-color); }
    .stat-green { color: var(--accent); font-weight: 700; font-size: 1.1rem; }
    .stat-yellow { color: #fbbf24; font-weight: 700; font-size: 1.1rem; }
    .text-yellow { color: #fbbf24; }
    .text-green { color: var(--accent); }
    .payment-form { display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .table-responsive { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.813rem; }
    th, td { padding: 0.75rem; border-bottom: 1px solid var(--border-color); }
    th { color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.7rem; }
    .badge-desembolso { color: #38bdf8; font-weight: 600; }
    .badge-pago { color: var(--accent); font-weight: 600; }
    .alert-error {
      background-color: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5; padding: 0.75rem; border-radius: 0.5rem; font-size: 0.813rem;
    }
  </style>
</LayoutAdmin>